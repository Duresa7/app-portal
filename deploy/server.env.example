# Copy to server.env (gitignored) or render it with `op inject -i server.env.example -o server.env`.
# The op:// references point at the 1Password item that holds the Action1 API credential.
Action1__Mode=Live
Action1__BaseUrl=https://app.na-2.action1.com/api/3.0
Action1__OrgId=op://Vault/Action1 API Credential - App Portal/organization id
Action1__ClientId=op://Vault/Action1 API Credential - App Portal/username
Action1__ClientSecret=op://Vault/Action1 API Credential - App Portal/credential
Portal__StatusPollSeconds=30
Portal__MaxActiveInstallsPerDevice=3
