# Copy to server.env (gitignored) and fill in the three Action1__ values, or render this file from
# your secrets manager's references. Keep it mode 600; it is the only place the credential exists on the host.
Action1__Mode=Live
Action1__BaseUrl=https://app.na-2.action1.com/api/3.0
Action1__OrgId=<organization id>
Action1__ClientId=<client id>
Action1__ClientSecret=<client secret>
Portal__StatusPollSeconds=30
Portal__MaxActiveInstallsPerDevice=3

# Optional directory sign-in for administrators. Leave these out entirely and the portal checks local
# accounts only, which is the default. docs/server-setup.md explains each setting.
# Directory__Enabled=true
# Directory__Servers__0=dc01.ad.example.com
# Directory__Servers__1=dc02.ad.example.com
# Directory__NetBiosDomain=EXAMPLE
# Directory__RequiredGroup=APP-AppPortal-Admins
# Directory__CertificateFile=/app/config/dc-certs.pem
# Directory__CertificateThumbprints__0=<sha-256 of the first controller's certificate>
# Directory__CertificateThumbprints__1=<sha-256 of the second controller's certificate>
