# Copy to server.env (gitignored) and fill in the three Action1__ values, or render this file from
# your secrets manager's references. Keep it mode 600; it is the only place the credential exists on the host.
Action1__Mode=Live
Action1__BaseUrl=https://app.na-2.action1.com/api/3.0
Action1__OrgId=<organization id>
Action1__ClientId=<client id>
Action1__ClientSecret=<client secret>
Portal__StatusPollSeconds=30
Portal__MaxActiveInstallsPerDevice=3
