<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="using:AppPortal.Client.ViewModels.Admin"
             xmlns:views="using:AppPortal.Client.Views.Admin"
             x:Class="AppPortal.Client.Views.Admin.CatalogView"
             x:DataType="admin:CatalogViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type admin:CatalogEditorViewModel}"><views:CatalogEditorView /></DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- The status pill of the web list: Visible on the success tint, Hidden in grey. -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>
        <Style Selector="Border.pill.off">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- The list. Hidden, not removed, while the editor is open, so the search and filter survive. -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding !IsEditing}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="title" Text="Catalog" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Classes="thin" Width="80" HorizontalAlignment="Left"
                             VerticalAlignment="Center" Margin="12,8,0,0" IsVisible="{Binding IsBusy}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="accent" Content="New app" Command="{Binding NewCommand}" />
                    <Button Classes="standard" Content="Import" Command="{Binding ImportCommand}"
                            ToolTip.Tip="Import a catalog file in the format Export writes" />
                    <Button Classes="standard" Content="Export" Command="{Binding ExportCommand}"
                            ToolTip.Tip="Save the whole catalog as catalog.json" />
                    <Button Classes="standard" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                        <PathIcon Data="{DynamicResource IconRefresh}" />
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="The apps devices can install. A hidden app keeps its install history but is no longer offered." />

            <StackPanel Grid.Row="2">
                <Border Classes="infoBar critical" Margin="0,0,0,8"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{DynamicResource IconError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="standard" Content="Hide instead" Margin="16,0,0,0" VerticalAlignment="Center"
                                Command="{Binding HideInsteadCommand}"
                                IsVisible="{Binding RefusedDelete, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
                <Border Classes="infoBar caution" Margin="0,0,0,8"
                        IsVisible="{Binding ConfirmingDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <PathIcon Grid.Column="0" Data="{DynamicResource IconWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DeletePrompt}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="accent" Content="Delete" Margin="16,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="3" Classes="standard" Content="Keep it" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding KeepAppCommand}" />
                    </Grid>
                </Border>
                <Border Classes="infoBar informational" Margin="0,0,0,8"
                        IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{DynamicResource IconCheck}" Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" ColumnDefinitions="280,12,160,*" Margin="0,0,0,16">
                <TextBox Grid.Column="0" Classes="search" PlaceholderText="Search apps" Text="{Binding SearchText}">
                    <TextBox.InnerRightContent>
                        <PathIcon Data="{DynamicResource IconSearch}" Width="14" Height="14" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <ComboBox Grid.Column="2" Classes="filter" ItemsSource="{x:Static admin:CatalogViewModel.Visibilities}"
                          SelectedIndex="{Binding Visibility}" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="3" Classes="caption" Text="{Binding CountText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <Border Grid.Row="4" Classes="card" Padding="4" VerticalAlignment="Top" Margin="0,0,0,24">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,140,130,76,206" Margin="12,8,12,8">
                        <TextBlock Grid.Column="0" Text="App" Classes="caption" />
                        <TextBlock Grid.Column="1" Text="Publisher" Classes="caption" />
                        <TextBlock Grid.Column="2" Text="Sources" Classes="caption" />
                        <TextBlock Grid.Column="3" Text="Status" Classes="caption" />
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,0" />
                    <ScrollViewer Grid.Row="2">
                        <StackPanel>
                            <TextBlock Classes="secondary" Margin="12,12" Text="No apps match." IsVisible="{Binding !Apps.Count}" />
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="admin:CatalogRowViewModel">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,140,130,76,206">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Publisher}" Classes="secondary" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Sources}" Classes="secondary" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <!-- Featured under the status rather than beside the name, where a long name would run into it. -->
                                                <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                                    <Border Classes="pill" Classes.off="{Binding Hidden}">
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </Border>
                                                    <Border Classes="pill off" IsVisible="{Binding Featured}">
                                                        <TextBlock Text="Featured" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Classes="standard" Content="Edit" Command="{Binding EditCommand}" />
                                                    <Button Classes="standard" Content="{Binding HideLabel}" Command="{Binding ToggleHiddenCommand}" MinWidth="62" />
                                                    <Button Classes="standard" Content="Delete" Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- The editor: a whole page, not a dialog, because of its size. -->
        <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditing}" />
    </Panel>
</UserControl>
