<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="using:AppPortal.Client.ViewModels.Admin"
             x:Class="AppPortal.Client.Views.Admin.ShowOnceDialog"
             x:DataType="admin:ShowOnceViewModel"
             IsVisible="{Binding IsOpen}">
    <!-- One dialog for every secret the server shows once: a new enrollment key, a device token, a
         generated password. Drawn like the sign-in dialog, a smoke layer and a card, over the page that
         asked for it. There is no way out but Done, so nobody loses a secret to a stray click. -->
    <Panel>
        <Border Background="#4D000000" CornerRadius="{DynamicResource OverlayCornerRadius}" />
        <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource OverlayCornerRadius}" BoxShadow="0 8 32 0 #40000000" ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Spacing="12" Margin="24,24,24,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{DynamicResource IconKey}" Width="20" Height="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Classes="subtitle" Text="{Binding Heading}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Explanation}" />
                    <!-- Read-only rather than a text block, so the secret can be selected and copied by hand. -->
                    <TextBox Text="{Binding Secret, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, Cascadia Mono, monospace"
                             TextWrapping="Wrap" />
                    <Border Classes="infoBar caution">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Grid.Column="0" Data="{DynamicResource IconWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       Text="Copy it now. This app does not keep it, and the server cannot show it again." />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="accent" Click="OnCopy">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{DynamicResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                          IsVisible="{Binding Copied}" />
                                <TextBlock Text="Copy" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CopyStatus}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="12,0" />
                        <Button Grid.Column="2" Classes="standard" MinWidth="96" Content="Done" Command="{Binding DismissCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
