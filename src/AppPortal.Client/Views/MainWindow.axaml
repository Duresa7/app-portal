<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppPortal.Client.ViewModels"
        xmlns:shared="using:AppPortal.Shared"
        xmlns:svc="using:AppPortal.Client.Services"
        xmlns:admin="using:AppPortal.Client.ViewModels.Admin"
        xmlns:adminViews="using:AppPortal.Client.Views.Admin"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="AppPortal.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-portal.ico"
        Title="App Portal"
        Width="1100" Height="720" MinWidth="800" MinHeight="520"
        TransparencyLevelHint="Mica, None"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{DynamicResource PortalFontFamily}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- One view per admin page, found by the page's view model type. A package that fills a page
         replaces that view and view model and leaves this list as it is. -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type admin:DashboardViewModel}"><adminViews:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:InstallsViewModel}"><adminViews:InstallsView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:CatalogViewModel}"><adminViews:CatalogView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:RequestsViewModel}"><adminViews:RequestsView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:DevicesViewModel}"><adminViews:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:KeysViewModel}"><adminViews:KeysView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:AdminsViewModel}"><adminViews:AdminsView /></DataTemplate>
        <DataTemplate DataType="{x:Type admin:SettingsViewModel}"><adminViews:SettingsView /></DataTemplate>
    </Window.DataTemplates>

    <!-- Two-layer layout: the base layer (Mica) carries navigation; the content layer is a lighter
         surface with an 8px top-left corner, as in Windows 11 NavigationView. -->
    <Grid ColumnDefinitions="280,*">

        <!-- Navigation pane -->
        <DockPanel Grid.Column="0" Margin="8,8,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="20,8,20,16">
                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <PathIcon Data="{StaticResource IconApps}" Width="16" Height="16" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="App Portal" Classes="bodyStrong" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Pane footer: this device -->
            <Border DockPanel.Dock="Bottom" Margin="16,0,16,16" Padding="12" Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconDevice}" Width="16" Height="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DeviceTitle}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DeviceSubtitle}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Button Classes="standard" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconRefresh}" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AppVersionText}" Classes="caption" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Pane footer: the way into the admin area, as Settings sits at the foot of a NavigationView. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,8" IsVisible="{Binding ShowAdminEntry}">
                <Button Classes="nav" Command="{Binding OpenSignInCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="indicator" Grid.Column="0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                            <PathIcon Data="{StaticResource IconShield}" />
                            <TextBlock Text="Admin" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <ScrollViewer>
                <StackPanel Margin="4,0,4,12">
                    <Button Classes="nav" Classes.selected="{Binding ShowApps}" Command="{Binding SelectSectionCommand}" CommandParameter="0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="indicator" Grid.Column="0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                <PathIcon Data="{StaticResource IconApps}" />
                                <TextBlock Text="Apps" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding ShowInstalled}" Command="{Binding SelectSectionCommand}" CommandParameter="1">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="indicator" Grid.Column="0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                <PathIcon Data="{StaticResource IconInstalled}" />
                                <TextBlock Text="Installed" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding ShowActivity}" Command="{Binding SelectSectionCommand}" CommandParameter="2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="indicator" Grid.Column="0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                <PathIcon Data="{StaticResource IconActivity}" />
                                <TextBlock Text="Activity" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="infoBadge" Margin="0,0,12,0" IsVisible="{Binding ActiveInstallCount}">
                                <TextBlock Text="{Binding ActiveInstallCount}" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding ShowRequests}" Command="{Binding SelectSectionCommand}" CommandParameter="3">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="indicator" Grid.Column="0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                <PathIcon Data="{StaticResource IconRequests}" />
                                <TextBlock Text="Requests" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- The admin group: shown only while an administrator is signed in on this PC. -->
                    <StackPanel IsVisible="{Binding IsAdminSignedIn}">
                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="16,10,16,10" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,2,16,6">
                            <TextBlock Classes="caption" FontWeight="SemiBold" Text="Admin" />
                            <TextBlock Classes="caption" Text="{Binding AdminUsername, StringFormat='· {0}'}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Dashboard.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconDashboard}" />
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Installs.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="11">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconDownload}" />
                                    <TextBlock Text="Installs" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Catalog.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconPackage}" />
                                    <TextBlock Text="Catalog" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Requests.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="13">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconRequests}" />
                                    <TextBlock Text="Requests" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="infoBadge" Margin="0,0,12,0" IsVisible="{Binding AdminArea.Requests.HasPending, FallbackValue=False}">
                                    <TextBlock Text="{Binding AdminArea.Requests.PendingCount, FallbackValue=''}" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Devices.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="14">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconDevice}" />
                                    <TextBlock Text="Devices" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Keys.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="15">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconKey}" />
                                    <TextBlock Text="Enrollment keys" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Admins.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconPerson}" />
                                    <TextBlock Text="Admins" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding AdminArea.Settings.IsSelected, FallbackValue=False}" Command="{Binding SelectSectionCommand}" CommandParameter="17">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconSettings}" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="nav" Command="{Binding SignOutCommand}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="indicator" Grid.Column="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                                    <PathIcon Data="{StaticResource IconSignOut}" />
                                    <TextBlock Text="Sign out" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Content layer -->
        <Border Grid.Column="1" Margin="0,8,0,0" CornerRadius="8,0,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
            <Grid RowDefinitions="Auto,*" Margin="36,28,36,0">

                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,8">
                    <Border Classes="infoBar caution" IsVisible="{Binding AdminNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding AdminNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="standard" Content="Sign in" Command="{Binding OpenSignInCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="standard" Content="Dismiss" Command="{Binding DismissAdminNoticeCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="infoBar critical" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{StaticResource IconError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="700" />
                        </StackPanel>
                    </Border>
                    <Border Classes="infoBar informational" IsVisible="{Binding UpdateReady}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconUpdate}" Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="accent" Content="Restart to update" Command="{Binding RestartToUpdateCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="infoBar informational" IsVisible="{Binding UpdateAvailable}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconUpdate}" Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="standard" Content="Update now" Command="{Binding UpdateNowCommand}" IsEnabled="{Binding !UpdateRequested}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="infoBar caution" IsVisible="{Binding IsDemo}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="700" Text="Demo mode. Everything here is sample data held in memory, nothing is installed, and nothing leaves this computer. Close and reopen without --demo to use a real server." />
                        </StackPanel>
                    </Border>
                    <Border Classes="infoBar caution" IsVisible="{Binding !IsConfigured}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <StackPanel Spacing="2" MaxWidth="700">
                                <TextBlock Classes="bodyStrong" Text="This device is not set up for App Portal" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="An administrator needs to write the server address and this device's token to " />
                                    <Run Text="{Binding ConfigPath}" FontFamily="Cascadia Mono, Consolas, monospace" />
                                    <Run Text=". Nothing here will work until then." />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Apps -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowApps}">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="title" Text="Apps" />
                            <ProgressBar IsIndeterminate="True" Classes="thin" Width="80" VerticalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding IsBusy}" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="Choose an app and it installs in the background. Administrator rights are not needed." />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="320,12,200,*" Margin="0,20,0,20">
                        <TextBox Grid.Column="0" Classes="search" PlaceholderText="Search apps" Text="{Binding SearchText}">
                            <TextBox.InnerRightContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <ComboBox Grid.Column="2" Classes="filter" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" Padding="0,0,12,0">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Classes="secondary" Margin="0,16,0,0" Text="No apps match your search." IsVisible="{Binding !FilteredApps.Count}" />
                            <ItemsControl ItemsSource="{Binding FilteredApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppItemViewModel">
                                        <Border Classes="card" Width="312" Margin="0,0,12,12">
                                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" Classes="tile" Background="{Binding TileBrush}" ClipToBounds="True">
                                                        <Panel>
                                                            <TextBlock Text="{Binding Initial}" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,2,0,0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Publisher}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Category}" Classes="caption" />
                                                        <TextBlock Text="{Binding DownloadSizeText}" IsVisible="{Binding HasDownloadSize}" Classes="caption" />
                                                        <TextBlock Text="Installs for you only" IsVisible="{Binding InstallsForYouOnly}" Classes="caption" />
                                                        <TextBlock Text="{Binding EngineText}" IsVisible="{Binding HasEngine}" Classes="caption" />
                                                        <TextBlock Text="{Binding RequirementsText}" IsVisible="{Binding HasRequirements}"
                                                                   TextWrapping="Wrap" Classes="caption" />
                                                        <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Classes="secondary" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsRestart}">
                                                            <TextBlock Text="{Binding RestartText}" TextWrapping="Wrap" Classes="caption" VerticalAlignment="Center" />
                                                            <Button Content="Restart now" Command="{Binding RestartCommand}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirming}">
                                                            <Button Content="Install anyway" Command="{Binding ConfirmInstallCommand}" />
                                                            <Button Content="Not now" Command="{Binding CancelInstallCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" Margin="0,14,0,14" MaxLines="2" TextTrimming="CharacterEllipsis" MinHeight="40" />
                                                <ProgressBar Grid.Row="2" Classes="thin" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,0,10" IsVisible="{Binding IsBusy}" />
                                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding IsInstalled}" />
                                                        <PathIcon Data="{StaticResource IconError}" Width="12" Height="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" IsVisible="{Binding HasError}" />
                                                        <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" MaxWidth="180" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="accent" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Installed -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowInstalled}">
                    <TextBlock Grid.Row="0" Classes="title" Text="Installed" />
                    <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,20" Text="Software the management service last reported on this device. Ask your administrator to remove something." />
                    <Border Grid.Row="2" Classes="card" Padding="4" VerticalAlignment="Top" Margin="0,0,0,24">
                        <ScrollViewer>
                            <StackPanel>
                                <Grid ColumnDefinitions="*,220,160" Margin="12,8,12,8">
                                    <TextBlock Grid.Column="0" Text="Name" Classes="caption" />
                                    <TextBlock Grid.Column="1" Text="Publisher" Classes="caption" />
                                    <TextBlock Grid.Column="2" Text="Version" Classes="caption" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,0" />
                                <TextBlock Classes="secondary" Margin="12,12" Text="No inventory has been reported yet." IsVisible="{Binding !Installed.Count}" />
                                <ItemsControl ItemsSource="{Binding Installed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="shared:InstalledApp">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="*,220,160">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Vendor}" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Version}" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Activity -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowActivity}">
                    <TextBlock Grid.Row="0" Classes="title" Text="Activity" />
                    <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,20" Text="Every install requested from this device, newest first." />
                    <Border Grid.Row="2" Classes="card" Padding="4" VerticalAlignment="Top" Margin="0,0,0,24">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Classes="secondary" Margin="12,12" Text="Nothing has been requested from this device yet." IsVisible="{Binding !Activity.Count}" />
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="Auto,*,150,170">
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding StateBrush}" VerticalAlignment="Center" Margin="4,0,14,0" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AppName}" Classes="bodyStrong" />
                                                        <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RequestedByText}" Classes="caption" IsVisible="{Binding HasRequestedBy}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding RequestedAt, Converter={x:Static svc:LocalTimeConverter.Instance}}" Classes="secondary" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding ShowRequests}">
                    <TextBlock Grid.Row="0" Classes="title" Text="Requests" />
                    <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,20" Text="Ask for software that is not in the catalog. An administrator answers here." />
                    <Border Grid.Row="2" Classes="card" Padding="16" Margin="0,0,0,16">
                        <StackPanel Spacing="10">
                            <TextBox Text="{Binding RequestText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                     MaxLength="{Binding RequestMaxLength}" PlaceholderText="What would you like installed, and what do you need it for?" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="accent" Command="{Binding SubmitRequestCommand}" Content="Submit" />
                                <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding RequestNotice}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Classes="card" Padding="4" VerticalAlignment="Top" Margin="0,0,0,24">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Classes="secondary" Margin="12,12" Text="Nothing has been asked for from this device yet." IsVisible="{Binding !Requests.Count}" />
                                <ItemsControl ItemsSource="{Binding Requests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RequestItemViewModel">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="Auto,*,110,170">
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding StatusBrush}" VerticalAlignment="Center" Margin="4,0,14,0" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" Classes="bodyStrong" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Reason}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                                                        <TextBlock Text="{Binding CatalogAppText}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasCatalogAppText}" />
                                                        <Button Classes="standard" Content="Show in Apps" Command="{Binding ShowAppCommand}"
                                                                IsVisible="{Binding CanShowApp}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding CreatedAt, Converter={x:Static svc:LocalTimeConverter.Instance}}" Classes="secondary" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Admin pages, 10 and up. The view comes from Window.DataTemplates above. -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentAdminPage}" IsVisible="{Binding ShowAdmin}" />
            </Grid>
        </Border>

        <adminViews:SignInView Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsSignInOpen}" />
    </Grid>
</Window>
