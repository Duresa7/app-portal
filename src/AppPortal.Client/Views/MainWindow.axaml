<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppPortal.Client.ViewModels"
        xmlns:shared="using:AppPortal.Shared"
        xmlns:svc="using:AppPortal.Client.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="AppPortal.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-portal.ico"
        Title="App Portal"
        Width="1100" Height="720" MinWidth="760" MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{DynamicResource PortalCard}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PortalCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PortalCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="300" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource PortalMuted}" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PortalAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0A000000" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,4,6,18">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PortalAccent}">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App Portal" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Self-service software" Classes="muted" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <Button Classes="nav" Classes.selected="{Binding ShowApps}" Command="{Binding SelectSectionCommand}" CommandParameter="0" Content="Apps" />
                    <Button Classes="nav" Classes.selected="{Binding ShowInstalled}" Command="{Binding SelectSectionCommand}" CommandParameter="1" Content="Installed" />
                    <Button Classes="nav" Classes.selected="{Binding ShowActivity}" Command="{Binding SelectSectionCommand}" CommandParameter="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Activity" />
                            <Border CornerRadius="9" Background="{DynamicResource PortalAccent}" Padding="7,1"
                                    IsVisible="{Binding ActiveInstallCount}">
                                <TextBlock Text="{Binding ActiveInstallCount}" Foreground="White" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="6,0,6,4">
                    <TextBlock Text="{Binding DeviceTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DeviceSubtitle}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <Button Command="{Binding RefreshCommand}" Content="Refresh" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Panel />
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28,22,16,16">

            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,12,14">
                <Border Background="#2AC42B1C" BorderBrush="{DynamicResource PortalError}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Background="#2AB8860B" BorderBrush="{DynamicResource PortalWarn}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                        IsVisible="{Binding !IsConfigured}">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="This device is not set up for App Portal." />
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="An administrator needs to write the server address and this device's token to " />
                            <Run Text="{Binding ConfigPath}" FontFamily="Consolas, monospace" />
                            <Run Text=". Nothing here will work until then." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Apps -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowApps}">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                    <TextBlock Classes="h1" Text="Apps" VerticalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                </StackPanel>
                <TextBlock Grid.Row="0" Classes="muted" Text="Pick an app and it installs in the background. You do not need administrator rights."
                           Margin="0,34,0,0" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,16,0,14">
                    <TextBox Width="300" PlaceholderText="Search apps" Text="{Binding SearchText}" />
                    <ComboBox Width="200" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel>
                        <TextBlock Classes="muted" Margin="0,24,0,0" Text="No apps match your search."
                                   IsVisible="{Binding !FilteredApps.Count}" />
                        <ItemsControl ItemsSource="{Binding FilteredApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppItemViewModel">
                                    <Border Classes="card">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource PortalAccent}">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Publisher}" Classes="muted" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Category}" Classes="muted" FontSize="11" Margin="0,10,0,0" />
                                            <TextBlock Grid.Row="2" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,12" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="4" Margin="0,0,0,8"
                                                         IsVisible="{Binding IsBusy}" />
                                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Classes="primary" Content="Install" Command="{Binding InstallCommand}"
                                                        IsVisible="{Binding CanInstall}" />
                                                <TextBlock Grid.Column="1" Text="Installed" Foreground="{DynamicResource PortalOk}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" IsVisible="{Binding IsInstalled}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Installed -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowInstalled}">
                <TextBlock Grid.Row="0" Classes="h1" Text="Installed" />
                <TextBlock Grid.Row="1" Classes="muted" Margin="0,4,0,14"
                           Text="Software the management service last reported on this device. Removal requests go to your administrator." />
                <DataGrid Grid.Row="2" ItemsSource="{Binding Installed}" IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" x:DataType="shared:InstalledApp" />
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Vendor}" Width="*" x:DataType="shared:InstalledApp" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" x:DataType="shared:InstalledApp" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Activity -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowActivity}">
                <TextBlock Grid.Row="0" Classes="h1" Text="Activity" />
                <TextBlock Grid.Row="1" Classes="muted" Margin="0,4,0,14" Text="Every install requested from this device, newest first." />
                <ScrollViewer Grid.Row="2">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="Nothing has been requested from this device yet." IsVisible="{Binding !Installs.Count}" />
                        <ItemsControl ItemsSource="{Binding Installs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="shared:InstallRequest">
                                    <Border BorderBrush="{DynamicResource PortalCardBorder}" BorderThickness="0,0,0,1" Padding="4,10">
                                        <Grid ColumnDefinitions="*,140,180">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding RequestedAt, Converter={x:Static svc:LocalTimeConverter.Instance}}" Classes="muted" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
