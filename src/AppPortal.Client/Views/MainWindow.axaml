<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppPortal.Client.ViewModels"
        xmlns:shared="using:AppPortal.Shared"
        xmlns:svc="using:AppPortal.Client.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="AppPortal.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-portal.ico"
        Title="App Portal"
        Width="1100" Height="720" MinWidth="800" MinHeight="520"
        TransparencyLevelHint="Mica, None"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{DynamicResource PortalFontFamily}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Two-layer layout: the base layer (Mica) carries navigation; the content layer is a lighter
         surface with an 8px top-left corner, as in Windows 11 NavigationView. -->
    <Grid ColumnDefinitions="280,*">

        <!-- Navigation pane -->
        <DockPanel Grid.Column="0" Margin="8,8,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,8,16,16">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <PathIcon Data="{StaticResource IconApps}" Width="16" Height="16" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="App Portal" Classes="bodyStrong" VerticalAlignment="Center" />
                </StackPanel>

                <Button Classes="nav" Classes.selected="{Binding ShowApps}" Command="{Binding SelectSectionCommand}" CommandParameter="0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="indicator" Grid.Column="0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                            <PathIcon Data="{StaticResource IconApps}" />
                            <TextBlock Text="Apps" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Classes="nav" Classes.selected="{Binding ShowInstalled}" Command="{Binding SelectSectionCommand}" CommandParameter="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="indicator" Grid.Column="0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                            <PathIcon Data="{StaticResource IconInstalled}" />
                            <TextBlock Text="Installed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Classes="nav" Classes.selected="{Binding ShowActivity}" Command="{Binding SelectSectionCommand}" CommandParameter="2">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="indicator" Grid.Column="0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                            <PathIcon Data="{StaticResource IconActivity}" />
                            <TextBlock Text="Activity" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="infoBadge" Margin="0,0,12,0" IsVisible="{Binding ActiveInstallCount}">
                            <TextBlock Text="{Binding ActiveInstallCount}" />
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Pane footer: this device -->
            <Border DockPanel.Dock="Bottom" Margin="16,0,16,16" Padding="12" Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconDevice}" Width="16" Height="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DeviceTitle}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DeviceSubtitle}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Button Classes="standard" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconRefresh}" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Panel />
        </DockPanel>

        <!-- Content layer -->
        <Border Grid.Column="1" Margin="0,8,0,0" CornerRadius="8,0,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
            <Grid RowDefinitions="Auto,*" Margin="36,28,36,0">

                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,8">
                    <Border Classes="infoBar critical" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{StaticResource IconError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="700" />
                        </StackPanel>
                    </Border>
                    <Border Classes="infoBar caution" IsVisible="{Binding !IsConfigured}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <StackPanel Spacing="2" MaxWidth="700">
                                <TextBlock Classes="bodyStrong" Text="This device is not set up for App Portal" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="An administrator needs to write the server address and this device's token to " />
                                    <Run Text="{Binding ConfigPath}" FontFamily="Cascadia Mono, Consolas, monospace" />
                                    <Run Text=". Nothing here will work until then." />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Apps -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowApps}">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="title" Text="Apps" />
                            <ProgressBar IsIndeterminate="True" Classes="thin" Width="80" VerticalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding IsBusy}" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="Choose an app and it installs in the background. Administrator rights are not needed." />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="320,12,200,*" Margin="0,20,0,20">
                        <TextBox Grid.Column="0" Classes="search" PlaceholderText="Search apps" Text="{Binding SearchText}">
                            <TextBox.InnerRightContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <ComboBox Grid.Column="2" Classes="filter" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" Padding="0,0,12,0">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Classes="secondary" Margin="0,16,0,0" Text="No apps match your search." IsVisible="{Binding !FilteredApps.Count}" />
                            <ItemsControl ItemsSource="{Binding FilteredApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppItemViewModel">
                                        <Border Classes="card" Width="312" Margin="0,0,12,12">
                                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" Classes="tile" Background="{Binding TileBrush}" ClipToBounds="True">
                                                        <Panel>
                                                            <TextBlock Text="{Binding Initial}" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,2,0,0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Publisher}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Category}" Classes="caption" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" Margin="0,14,0,14" MaxLines="2" TextTrimming="CharacterEllipsis" MinHeight="40" />
                                                <ProgressBar Grid.Row="2" Classes="thin" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,0,10" IsVisible="{Binding IsBusy}" />
                                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding IsInstalled}" />
                                                        <PathIcon Data="{StaticResource IconError}" Width="12" Height="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" IsVisible="{Binding HasError}" />
                                                        <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" MaxWidth="180" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="accent" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Installed -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowInstalled}">
                    <TextBlock Grid.Row="0" Classes="title" Text="Installed" />
                    <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,20" Text="Software the management service last reported on this device. Ask your administrator to remove something." />
                    <Border Grid.Row="2" Classes="card" Padding="4" VerticalAlignment="Top" Margin="0,0,0,24">
                        <ScrollViewer>
                            <StackPanel>
                                <Grid ColumnDefinitions="*,220,160" Margin="12,8,12,8">
                                    <TextBlock Grid.Column="0" Text="Name" Classes="caption" />
                                    <TextBlock Grid.Column="1" Text="Publisher" Classes="caption" />
                                    <TextBlock Grid.Column="2" Text="Version" Classes="caption" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,0" />
                                <TextBlock Classes="secondary" Margin="12,12" Text="No inventory has been reported yet." IsVisible="{Binding !Installed.Count}" />
                                <ItemsControl ItemsSource="{Binding Installed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="shared:InstalledApp">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="*,220,160">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Vendor}" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Version}" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Activity -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowActivity}">
                    <TextBlock Grid.Row="0" Classes="title" Text="Activity" />
                    <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,20" Text="Every install requested from this device, newest first." />
                    <Border Grid.Row="2" Classes="card" Padding="4" VerticalAlignment="Top" Margin="0,0,0,24">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Classes="secondary" Margin="12,12" Text="Nothing has been requested from this device yet." IsVisible="{Binding !Activity.Count}" />
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="Auto,*,150,170">
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding StateBrush}" VerticalAlignment="Center" Margin="4,0,14,0" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AppName}" Classes="bodyStrong" />
                                                        <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding RequestedAt, Converter={x:Static svc:LocalTimeConverter.Instance}}" Classes="secondary" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
