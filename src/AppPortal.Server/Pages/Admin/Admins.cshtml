@page "/admin/admins"
@model AdminsModel
@{
    ViewData["Title"] = "Administrators";
    ViewData["Nav"] = "admins";
}
@if (Model.Error is not null)
{
    <div class="message error">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="message ok">@Model.Notice</div>
}

<div class="card">
    <h2>Accounts</h2>
    <partial name="Shared/_AdminTable" model="Model.Admins" />
</div>

<div class="card">
    <h2>Add an administrator</h2>
    @if (Model.DirectoryEnabled)
    {
        <p class="muted">
            Accounts added here keep their password in this portal. A directory account needs nothing added:
            it appears in the table above the first time somebody in @Model.DirectoryGroup signs in with it.
        </p>
    }
    <form method="post" asp-page-handler="Add">
        <label for="new-username">User name</label>
        <input id="new-username" name="NewUsername" type="text" autocomplete="off" />

        <label for="new-password">Password</label>
        <input id="new-password" name="NewPassword" type="password" autocomplete="new-password" />

        <div class="actions">
            <button type="submit">Add</button>
            <span class="muted">At least @AppPortal.Server.Admin.AdminStore.MinimumPasswordLength characters.</span>
        </div>
    </form>
</div>

<div class="card">
    <h2>Reset a password</h2>
    <form method="post" asp-page-handler="Reset">
        <label for="reset-username">User name</label>
        <input id="reset-username" name="ResetUsername" type="text" autocomplete="off" />

        <label for="reset-password">New password</label>
        <input id="reset-password" name="ResetPassword" type="password" autocomplete="new-password" />

        <div class="actions">
            <button type="submit">Reset</button>
            <span class="muted">Every session that account holds is signed out. Local accounts only; a directory password lives in the directory.</span>
        </div>
    </form>
</div>
