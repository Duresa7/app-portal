@page "/admin/catalog/{id}"
@model AppPortal.Server.Pages.Admin.Catalog.EditModel
@using AppPortal.Server.Pages.Admin.Catalog
@using AppPortal.Shared
@{
    ViewData["Title"] = Model.IsNew ? "New app" : Model.Name;
    ViewData["Nav"] = "catalog";
    var here = "/admin/catalog/" + (Model.IsNew ? EditModel.NewId : Model.Id);
}
@if (Model.Error is not null)
{
    <div class="message error">@Model.Error</div>
}
@if (Model.HelperMessage is not null)
{
    <div class="message">@Model.HelperMessage</div>
}
@if (Model.Saved && Model.Linked == "yes")
{
    <div class="message ok">Saved and linked to the request. The person who asked is offered it on their next refresh.</div>
}
else if (Model.Saved && Model.Linked == "no")
{
    <div class="message error">Saved, but the request was not linked. Link it from the Requests page.</div>
}
else if (Model.Saved)
{
    <div class="message ok">Saved. Devices pick this up on their next refresh.</div>
}

<form method="post" id="catalog-form">
    @if (Model.SourceRequest is { } source)
    {
        @* Every part of the request came from whoever typed it on their PC, so Razor's encoding is all
           that stands between it and the page. Nothing here may be written raw. *@
        <input type="hidden" name="FromRequest" value="@Model.FromRequest" />
        var requester = string.IsNullOrWhiteSpace(source.RequestedBy) ? "an unknown user" : source.RequestedBy;
        <div class="card">
            <p>For the request from @requester on @source.DeviceName: @source.Text. The name and id are suggested from it, so check both. Saving links the request to this app.</p>
        </div>
    }
    <div class="card">
        <h2>App</h2>
        @if (Model.IsNew)
        {
            <label for="id">Id</label>
            <input id="id" name="Id" type="text" value="@Model.Id" autocomplete="off" />
            <p class="muted">Lower case, no spaces, for example <code>google-chrome</code>. It cannot be changed later.</p>
        }
        else
        {
            <label>Id</label>
            <p class="muted">@Model.Id</p>
        }

        <label for="name">Name</label>
        <input id="name" name="Name" type="text" value="@Model.Name" autocomplete="off" />

        <label for="publisher">Publisher</label>
        <input id="publisher" name="Publisher" type="text" value="@Model.Publisher" autocomplete="off" />

        <label for="description">Description</label>
        <input id="description" name="Description" type="text" value="@Model.Description" autocomplete="off" />

        <label for="category">Category</label>
        <input id="category" name="Category" type="text" value="@Model.Category" autocomplete="off" />

        <label for="icon">Icon URL</label>
        <input id="icon" name="IconUrl" type="text" value="@Model.IconUrl" autocomplete="off" />

        <label class="check">
            <input name="Featured" type="checkbox" value="true" checked="@Model.Featured" />
            Featured, which sorts it to the front of the client's list
        </label>
        <label class="check">
            <input name="Hidden" type="checkbox" value="true" checked="@Model.Hidden" />
            Hidden, which keeps the app and its history but stops offering it to devices
        </label>
    </div>

    <div class="card">
        <h2>Where it comes from</h2>
        <label for="source">Source</label>
        <select id="source" name="Source">
            <option value="@EditModel.SourceAction1" selected="@(Model.Source == EditModel.SourceAction1)"
                    data-purpose="A package from your Action1 Software Repository. Action1 always installs for everyone on the PC.">Action1</option>
            <option value="@WingetSources.Winget" selected="@(Model.Source == WingetSources.Winget)"
                    data-purpose="Windows applications, from Microsoft's community repository. The usual choice for most software.">winget</option>
            <option value="@WingetSources.Store" selected="@(Model.Source == WingetSources.Store)"
                    data-purpose="Store applications, by their product id. They install into the profile of the person who asks.">Microsoft Store</option>
            <optgroup label="A package manager on the PC">
                @foreach (var manager in PackageManagers.All)
                {
                    <option value="@manager.Name" selected="@(Model.Source == manager.Name)"
                            data-purpose="@manager.Purpose" data-scopes="@string.Join(',', manager.Scopes)"
                            data-pins="@(manager.CanPinVersion ? "yes" : "no")"
                            data-devices="@Model.DevicesWith(manager.Name)">@manager.DisplayName</option>
                }
            </optgroup>
            <option value="@EditModel.SourceDirect" selected="@(Model.Source == EditModel.SourceDirect)"
                    data-purpose="Any installer at a web address, checked against its SHA-256. For game launchers and vendor installers that are in no repository.">Direct download</option>
        </select>
        <p class="muted" id="source-purpose"></p>
        <p class="muted" id="source-devices"></p>

        <div id="package-fields">
            <label for="source-id" id="source-id-label">Package id</label>
            <input id="source-id" name="SourceId" value="@Model.SourceId" autocomplete="off" />
            <p class="muted" id="store-hint" hidden>
                A Store product id is the last part of the app's address in the Store, such as 9WZDNCRFJ3TJ.
                Some Store apps need the person signed in to the Store before the Store will grant a licence;
                say so under Requirements and the portal will show it before they install.
            </p>
            <p class="muted" id="manager-hint" hidden>
                Exactly as the package manager names it: letters, digits and the separators that manager uses,
                and nothing a command prompt would read as an instruction. The manager itself has to be on the PC;
                if it might not be, add it to the catalog and list it under Needs first, and the portal installs it first.
            </p>
            <label for="source-version">Version (optional)</label>
            <input id="source-version" name="SourceVersion" value="@Model.SourceVersion" autocomplete="off" />
            <label for="source-extra">Extra arguments (optional)</label>
            <input id="source-extra" name="SourceExtraArgs" value="@Model.SourceExtraArgs" autocomplete="off" />
            <p class="muted">Passed on as you type them. The agent does not check these; they are yours.</p>
            <button type="submit" class="secondary" id="lookup" asp-page-handler="LookupWinget">Look up this id</button>
        </div>

        <div id="direct-fields">
            <label for="direct-url">Installer URL</label>
            <input id="direct-url" name="DirectUrl" value="@Model.DirectUrl" />
            <label for="direct-sha256">SHA-256</label>
            <input id="direct-sha256" name="DirectSha256" value="@Model.DirectSha256" />
            <label for="direct-type">Installer type</label>
            <select id="direct-type" name="DirectInstallerType">
                <option value="exe" selected="@(Model.DirectInstallerType == "exe")">exe</option>
                <option value="msi" selected="@(Model.DirectInstallerType == "msi")">msi</option>
                <option value="msix" selected="@(Model.DirectInstallerType == "msix")">msix</option>
            </select>
            <label for="direct-args">Silent arguments</label>
            <input id="direct-args" name="DirectSilentArgs" value="@Model.DirectSilentArgs" placeholder="/S or /qn" />
            <p class="muted">Leave this empty for an msix, and for an exe that installs silently on its own. An msi always needs them; the agent adds /qn /norestart itself, so put here whatever else this package takes.</p>
            <label for="direct-size">Download size (bytes)</label>
            <input id="direct-size" name="DirectSizeBytes" type="number" min="1" step="1" value="@Model.DirectSizeBytes" />
            <label for="direct-uninstall">Uninstall key (optional)</label>
            <input id="direct-uninstall" name="DirectUninstallKey" value="@Model.DirectUninstallKey" />
            <button type="submit" class="secondary" asp-page-handler="FetchAndHash">Fetch and hash</button>
            <p class="muted">Fetch and hash downloads the installer to calculate its hash and size. For files over the server's limit, enter these values manually.</p>
        </div>

        <div id="agent-fields">
            <label for="source-scope">Installs for</label>
            <select id="source-scope" name="SourceScope">
                <option value="machine" selected="@(Model.SourceScope == "machine")">Everyone on the PC</option>
                <option value="user" selected="@(Model.SourceScope == "user")">The person who asks for it</option>
            </select>
            <label for="source-reboot">
                <input id="source-reboot" name="SourceRequiresReboot" type="checkbox" value="true" checked="@Model.SourceRequiresReboot" />
                The software only works after a restart
            </label>
        </div>

        <details id="action1-details" open="@(Model.Source == EditModel.SourceAction1 || !string.IsNullOrWhiteSpace(Model.PackageId))">
            <summary id="action1-summary">Also offer it through Action1 (optional)</summary>
            <p class="muted" id="action1-hint">Leave the package id empty when this app only comes from the source above.</p>
            <label for="package-id">Action1 package id</label>
            <input id="package-id" name="PackageId" type="text" value="@Model.PackageId" autocomplete="off" />

            <label for="version">Action1 version</label>
            <input id="version" name="Version" type="text" value="@Model.Version" autocomplete="off" />
            <p class="muted"><code>latest</code>, or an exact version published in the Software Repository.</p>

            <div class="actions">
                <button type="button" class="secondary"
                        hx-get="@here?handler=Search"
                        hx-vals='js:{term: document.getElementById("package-id").value || document.getElementById("name").value}'
                        hx-target="#package-search"
                        hx-swap="outerHTML">Search the repository</button>
                <button type="button" class="secondary"
                        hx-get="@here?handler=Verify"
                        hx-vals='js:{packageId: document.getElementById("package-id").value, version: document.getElementById("version").value}'
                        hx-target="#package-verify"
                        hx-swap="outerHTML">Verify</button>
            </div>

            <div id="package-verify"></div>
            <div id="package-search"></div>
        </details>

        <div id="engine-fields">
            <label for="engine-override">When a device could use either Action1 or the agent</label>
            <select id="engine-override" name="EngineOverride">
                <option value="" selected="@(string.IsNullOrEmpty(Model.EngineOverride))">Follow the server's default</option>
                <option value="action1" selected="@(Model.EngineOverride == "action1")">Use Action1</option>
                <option value="agent" selected="@(Model.EngineOverride == "agent")">Use the agent</option>
            </select>
            <p class="muted">A device set to prefer an engine still wins over this.</p>
        </div>
    </div>

    <div class="card">
        <h2>Inventory match</h2>
        <p class="muted">
            How the portal decides this app is already installed. Left empty, the app name is used; an app
            from a package manager is also found by its package id.
        </p>
        <label for="match">Installed name contains</label>
        <input id="match" name="MatchNameContains" type="text" value="@Model.MatchNameContains" autocomplete="off" />
        <label for="match-exact">Installed name equals</label>
        <input id="match-exact" name="MatchNameEquals" type="text" value="@Model.MatchNameEquals" autocomplete="off" />
        <p class="muted">An exact name takes precedence over the contains rule.</p>
    </div>

    <div class="card">
        <label for="user-removable">
            <input id="user-removable" name="UserRemovable" type="checkbox" value="true" checked="@Model.UserRemovable" />
            Let the person who installed this remove it themselves
        </label>
        <p class="muted">Off by default. An administrator can always remove it from the device page.</p>

        <h2>Needs first</h2>
        <label for="requires">Catalog app ids to install before this one, one per line (optional)</label>
        <textarea id="requires" name="Requires" rows="3">@Model.Requires</textarea>
        <p class="muted">Installed in the order written, as one install. Anything already on the PC is skipped.</p>

        <h2>Requirements</h2>
        <label for="requirements">What this app needs, in your own words (optional)</label>
        <textarea id="requirements" name="Requirements" rows="3" maxlength="500"
                  placeholder="Needs Secure Boot and TPM 2.0 turned on. Needs a vendor account. Windows 11 only.">@Model.Requirements</textarea>
        <p class="muted">
            Shown on the app and confirmed by the person before they install it. The portal does not
            check any of this and will never refuse an install because of it.
        </p>
    </div>

    <div class="card">
        <h2>What this will do</h2>
        <p id="sentence"
           hx-post="@here?handler=Describe"
           hx-include="#catalog-form"
           hx-trigger="change from:#catalog-form, keyup changed delay:600ms from:#catalog-form">@Model.Sentence</p>
    </div>

    <div class="actions">
        <button type="submit">Save</button>
        <a class="button secondary" href="/admin/catalog">Back to the catalog</a>
    </div>
</form>

<script>
    // One selector decides which fields exist. Each source says what it is for, and a package
    // manager says which scopes it can really carry out, so choosing npm to deploy a browser, or
    // Cargo for everyone on a PC, looks odd on the form rather than failing on every device later.
    const source = document.getElementById('source');
    const scope = document.getElementById('source-scope');
    const version = document.getElementById('source-version');
    const packageId = document.getElementById('package-id');
    const action1 = document.getElementById('action1-details');

    function chosen() {
        return source.options[source.selectedIndex];
    }

    function showEngine() {
        // The override only means something for an app that has both kinds of package.
        document.getElementById('engine-fields').hidden = source.value === 'action1' || packageId.value.trim() === '';
    }

    function showSource() {
        const value = source.value;
        const option = chosen();
        const manager = option.dataset.scopes !== undefined;
        const agent = value !== 'action1';
        const store = value === 'msstore';

        document.getElementById('source-purpose').textContent = option.dataset.purpose;
        document.getElementById('package-fields').hidden = !(value === 'winget' || store || manager);
        document.getElementById('direct-fields').hidden = value !== 'direct';
        document.getElementById('agent-fields').hidden = !agent;
        document.getElementById('lookup').hidden = !(value === 'winget' || store);
        document.getElementById('store-hint').hidden = !store;
        document.getElementById('manager-hint').hidden = !manager;
        document.getElementById('source-id-label').textContent = store ? 'Store product id' : value === 'winget' ? 'Winget id' : 'Package id';
        document.getElementById('source-id').placeholder = store ? '9WZDNCRFJ3TJ' : value === 'winget' ? 'Valve.Steam' : manager ? '7zip' : '';

        // Action1 as the source is the Action1 section itself, not an optional extra to it.
        document.getElementById('action1-summary').hidden = !agent;
        document.getElementById('action1-hint').hidden = !agent;
        if (!agent) {
            action1.open = true;
        }

        const devices = document.getElementById('source-devices');
        devices.textContent = '';
        const scopes = manager ? option.dataset.scopes.split(',') : ['machine', 'user'];
        for (const item of scope.options) {
            item.disabled = !scopes.includes(item.value);
        }
        if (!scopes.includes(scope.value)) {
            scope.value = scopes[0];
        }
        version.disabled = manager && option.dataset.pins !== 'yes';
        version.placeholder = version.disabled ? 'This manager always installs its current version' : '';
        if (manager) {
            const count = Number(option.dataset.devices);
            devices.textContent = count === 0
                ? 'No enrolled device reports ' + option.textContent + ' yet. Add it to the catalog and list it under Needs first, and the portal installs it first.'
                : count + (count === 1 ? ' enrolled device reports ' : ' enrolled devices report ') + option.textContent + '.';
        }
        showEngine();
    }

    source.addEventListener('change', function () {
        // Only when the person changes the source, never on load: on load the value is the one that
        // was saved, and moving it would rewrite an administrator's own choice behind their back.
        if (source.value === 'msstore') {
            scope.value = 'user';
        }
        showSource();
    });
    packageId.addEventListener('input', showEngine);
    showSource();
</script>
