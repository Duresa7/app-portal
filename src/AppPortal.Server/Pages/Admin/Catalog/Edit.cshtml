@page "/admin/catalog/{id}"
@model AppPortal.Server.Pages.Admin.Catalog.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New app" : Model.Name;
    ViewData["Nav"] = "catalog";
}
@if (Model.Error is not null)
{
    <div class="message error">@Model.Error</div>
}
@if (Model.HelperMessage is not null)
{
    <div class="message">@Model.HelperMessage</div>
}
@if (Model.Saved)
{
    <div class="message ok">Saved. Devices pick this up on their next refresh.</div>
}

<form method="post">
    <div class="card">
        <h2>App</h2>
        @if (Model.IsNew)
        {
            <label for="id">Id</label>
            <input id="id" name="Id" type="text" value="@Model.Id" autocomplete="off" />
            <p class="muted">Lower case, no spaces, for example <code>google-chrome</code>. It cannot be changed later.</p>
        }
        else
        {
            <label>Id</label>
            <p class="muted">@Model.Id</p>
        }

        <label for="name">Name</label>
        <input id="name" name="Name" type="text" value="@Model.Name" autocomplete="off" />

        <label for="publisher">Publisher</label>
        <input id="publisher" name="Publisher" type="text" value="@Model.Publisher" autocomplete="off" />

        <label for="description">Description</label>
        <input id="description" name="Description" type="text" value="@Model.Description" autocomplete="off" />

        <label for="category">Category</label>
        <input id="category" name="Category" type="text" value="@Model.Category" autocomplete="off" />

        <label for="icon">Icon URL</label>
        <input id="icon" name="IconUrl" type="text" value="@Model.IconUrl" autocomplete="off" />

        <label class="check">
            <input name="Featured" type="checkbox" value="true" checked="@Model.Featured" />
            Featured, which sorts it to the front of the client's list
        </label>
        <label class="check">
            <input name="Hidden" type="checkbox" value="true" checked="@Model.Hidden" />
            Hidden, which keeps the app and its history but stops offering it to devices
        </label>
    </div>

    <div class="card">
        <h2>Inventory match</h2>
        <p class="muted">
            How the client decides this app is already installed. Left empty, the app name is used.
        </p>
        <label for="match">Installed name contains</label>
        <input id="match" name="MatchNameContains" type="text" value="@Model.MatchNameContains" autocomplete="off" />
        <label for="match-exact">Installed name equals</label>
        <input id="match-exact" name="MatchNameEquals" type="text" value="@Model.MatchNameEquals" autocomplete="off" />
        <p class="muted">An exact name takes precedence over the contains rule.</p>
    </div>

    <div class="card">
        <h2>Action1 package</h2>
        <p class="muted">Leave the package id empty when this app only has an agent package.</p>
        <label for="package-id">Package id</label>
        <input id="package-id" name="PackageId" type="text" value="@Model.PackageId" autocomplete="off" />

        <label for="version">Version</label>
        <input id="version" name="Version" type="text" value="@Model.Version" autocomplete="off" />
        <p class="muted"><code>latest</code>, or an exact version published in the Software Repository.</p>

        <div class="actions">
            <button type="button" class="secondary"
                    hx-get="/admin/catalog/@(Model.IsNew ? AppPortal.Server.Pages.Admin.Catalog.EditModel.NewId : Model.Id)?handler=Search"
                    hx-vals='js:{term: document.getElementById("package-id").value || document.getElementById("name").value}'
                    hx-target="#package-search"
                    hx-swap="outerHTML">Search the repository</button>
            <button type="button" class="secondary"
                    hx-get="/admin/catalog/@(Model.IsNew ? AppPortal.Server.Pages.Admin.Catalog.EditModel.NewId : Model.Id)?handler=Verify"
                    hx-vals='js:{packageId: document.getElementById("package-id").value, version: document.getElementById("version").value}'
                    hx-target="#package-verify"
                    hx-swap="outerHTML">Verify</button>
        </div>

        <div id="package-verify"></div>
        <div id="package-search"></div>
    </div>

    <div class="card">
        <label for="user-removable">
            <input id="user-removable" name="UserRemovable" type="checkbox" value="true" checked="@Model.UserRemovable" />
            Let the person who installed this remove it themselves
        </label>
        <p class="muted">Off by default. An administrator can always remove it from the device page.</p>

        <h2>Needs first</h2>
        <label for="requires">Catalog app ids to install before this one, one per line (optional)</label>
        <textarea id="requires" name="Requires" rows="3">@Model.Requires</textarea>
        <p class="muted">Installed in the order written, as one install. Anything already on the PC is skipped.</p>

        <h2>Requirements</h2>
        <label for="requirements">What this app needs, in your own words (optional)</label>
        <textarea id="requirements" name="Requirements" rows="3" maxlength="500"
                  placeholder="Needs Secure Boot and TPM 2.0 turned on. Needs a vendor account. Windows 11 only.">@Model.Requirements</textarea>
        <p class="muted">
            Shown on the app and confirmed by the person before they install it. The portal does not
            check any of this and will never refuse an install because of it.
        </p>

        <h2>Engine</h2>
        <label for="engine-override">Prefer</label>
        <select id="engine-override" name="EngineOverride">
            <option value="" selected="@(string.IsNullOrEmpty(Model.EngineOverride))">The server's default</option>
            <option value="action1" selected="@(Model.EngineOverride == "action1")">Action1</option>
            <option value="agent" selected="@(Model.EngineOverride == "agent")">Agent</option>
        </select>
        <p class="muted">Only matters on a device that could use either. A device set to prefer an engine still wins over this.</p>

        <h2>Agent package</h2>
        <label for="agent-kind">Kind</label>
        <select id="agent-kind" name="AgentKind">
            <option value="" selected="@(string.IsNullOrEmpty(Model.AgentKind))">None</option>
            <option value="winget" selected="@(Model.AgentKind == "winget")">Winget</option>
            <option value="direct" selected="@(Model.AgentKind == "direct")">Direct installer</option>
        </select>
        <div id="winget-fields">
            <label for="winget-id">Winget id</label>
            <input id="winget-id" name="WingetId" value="@Model.WingetId" placeholder="Valve.Steam" />
            <label for="winget-scope">Scope</label>
            <select id="winget-scope" name="WingetScope">
                <option value="machine" selected="@(Model.WingetScope == "machine")">Machine</option>
                <option value="user" selected="@(Model.WingetScope == "user")">User</option>
            </select>
            <label for="winget-version">Version (optional)</label>
            <input id="winget-version" name="WingetVersion" value="@Model.WingetVersion" />
            <label for="winget-extra">Extra arguments (optional)</label>
            <input id="winget-extra" name="WingetExtraArgs" value="@Model.WingetExtraArgs" />
            <label for="winget-reboot">
                <input id="winget-reboot" name="WingetRequiresReboot" type="checkbox" value="true" checked="@Model.WingetRequiresReboot" />
                The software only works after a restart
            </label>
            <button type="submit" class="secondary" asp-page-handler="LookupWinget">Look up winget id</button>
        </div>
        <div id="direct-fields">
            <label for="direct-url">Installer URL</label>
            <input id="direct-url" name="DirectUrl" value="@Model.DirectUrl" />
            <label for="direct-sha256">SHA-256</label>
            <input id="direct-sha256" name="DirectSha256" value="@Model.DirectSha256" />
            <label for="direct-type">Installer type</label>
            <select id="direct-type" name="DirectInstallerType">
                <option value="exe" selected="@(Model.DirectInstallerType == "exe")">exe</option>
                <option value="msi" selected="@(Model.DirectInstallerType == "msi")">msi</option>
                <option value="msix" selected="@(Model.DirectInstallerType == "msix")">msix</option>
            </select>
            <label for="direct-scope">Scope</label>
            <select id="direct-scope" name="DirectScope">
                <option value="machine" selected="@(Model.DirectScope == "machine")">Machine</option>
                <option value="user" selected="@(Model.DirectScope == "user")">User</option>
            </select>
            <label for="direct-args">Silent arguments</label>
            <input id="direct-args" name="DirectSilentArgs" value="@Model.DirectSilentArgs" placeholder="/S or /qn" />
            <p class="muted">Leave this empty for an msix, and for an exe that installs silently on its own. An msi always needs them; the agent adds /qn /norestart itself, so put here whatever else this package takes.</p>
            <label for="direct-size">Download size (bytes)</label>
            <input id="direct-size" name="DirectSizeBytes" type="number" min="1" step="1" value="@Model.DirectSizeBytes" />
            <label for="direct-uninstall">Uninstall key (optional)</label>
            <input id="direct-uninstall" name="DirectUninstallKey" value="@Model.DirectUninstallKey" />
            <label for="direct-reboot">
                <input id="direct-reboot" name="DirectRequiresReboot" type="checkbox" value="true" checked="@Model.DirectRequiresReboot" />
                The software only works after a restart
            </label>
            <button type="submit" class="secondary" asp-page-handler="FetchAndHash">Fetch and hash</button>
            <p class="muted">Fetch and hash downloads the installer to calculate its hash and size. For files over the server's limit, enter these values manually.</p>
        </div>
    </div>

    <div class="actions">
        <button type="submit">Save</button>
        <a class="button secondary" href="/admin/catalog">Back to the catalog</a>
    </div>
</form>

<script>
    const kind = document.getElementById('agent-kind');
    function showAgentFields() {
        document.getElementById('winget-fields').hidden = kind.value !== 'winget';
        document.getElementById('direct-fields').hidden = kind.value !== 'direct';
    }
    kind.addEventListener('change', showAgentFields);
    showAgentFields();
</script>
