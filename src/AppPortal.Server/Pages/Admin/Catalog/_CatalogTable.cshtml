@using AppPortal.Server.Admin.Lists
@using AppPortal.Server.Catalog
@model Slice<CatalogEntry>
@{
    // The messages travel with the rows because htmx swaps this fragment alone: a refused delete has
    // to explain itself inside the thing that came back, or the reason never reaches the screen.
    var list = ViewData.Page();

    // Every source the app has, named the way the edit page names it. The column used to say Action1
    // or none, so an app the agent installs read as having nothing at all.
    static string Sources(CatalogEntry app)
    {
        var sources = new List<string>();
        if (app.HasAction1)
        {
            sources.Add("Action1");
        }

        sources.Add(app.Agent switch
        {
            AppPortal.Shared.WingetPackageDefinition { Source: AppPortal.Shared.WingetSources.Store } => "Microsoft Store",
            AppPortal.Shared.WingetPackageDefinition => "winget",
            AppPortal.Shared.DirectPackageDefinition => "Direct download",
            AppPortal.Shared.ManagedPackageDefinition managed => AppPortal.Shared.PackageManagers.Find(managed.Manager)?.DisplayName ?? managed.Manager,
            _ => "",
        });
        var named = sources.Where(s => s.Length > 0).ToList();
        return named.Count == 0 ? "none" : string.Join(", ", named);
    }
}
<div id="catalog-table">
    @if (list.Error is not null)
    {
        <div class="message error">@list.Error</div>
    }
    @if (list.Notice is not null)
    {
        <div class="message ok">@list.Notice</div>
    }
    <table>
        <thead>
        <tr>
            <th>App</th>
            <th>Publisher</th>
            <th>Category</th>
            <th>Engines</th>
            <th>Status</th>
            <th class="right">Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="6" class="muted">No apps match.</td>
            </tr>
        }
        @foreach (var app in Model.Rows)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(app.IconUrl))
                    {
                        <img src="@app.IconUrl" alt="" width="24" height="24" />
                    }
                    <a href="/admin/catalog/@app.Id">@app.Name</a>
                    @if (app.Featured)
                    {
                        <span class="pill">Featured</span>
                    }
                    <div class="muted">@app.Id</div>
                </td>
                <td>@app.Publisher</td>
                <td>@app.Category</td>
                <td class="muted">@Sources(app)</td>
                <td>
                    @if (app.Hidden)
                    {
                        <span class="pill off">Hidden</span>
                    }
                    else
                    {
                        <span class="pill">Visible</span>
                    }
                </td>
                <td class="right">
                    <button class="secondary"
                            hx-post="/admin/catalog?handler=Hide"
                            hx-vals='@($"{{\"id\":\"{app.Id}\",\"hidden\":{(app.Hidden ? "false" : "true")}}}")'
                            hx-target="#catalog-table"
                            hx-swap="outerHTML">@(app.Hidden ? "Show" : "Hide")</button>
                    <button class="secondary"
                            hx-post="/admin/catalog?handler=Delete"
                            hx-vals='@($"{{\"id\":\"{app.Id}\"}}")'
                            hx-target="#catalog-table"
                            hx-swap="outerHTML"
                            hx-confirm="Delete @app.Name from the catalog? Hiding keeps its install history.">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
