@page "/admin"
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Nav"] = "dashboard";
}
<div class="tiles">
    <div class="card tile">
        <div class="value">@Model.Devices</div>
        <div class="label">Devices</div>
    </div>
    <a class="card tile" href="/admin/installs?From=@DateTime.Today.ToString("yyyy-MM-dd")">
        <div class="value">@Model.InstallsToday</div>
        <div class="label">Installs today</div>
    </a>
    <a class="card tile" href="/admin/installs?State=Failed">
        <div class="value @(Model.FailuresThisWeek > 0 ? "bad" : "")">@Model.FailuresThisWeek</div>
        <div class="label">Failures this week</div>
    </a>
    <a class="card tile" href="/admin/installs?State=Running">
        <div class="value">@Model.ActiveNow</div>
        <div class="label">Active now</div>
    </a>
    <div class="card tile">
        <div class="value">@Model.PendingRequests</div>
        <div class="label">Pending requests</div>
    </div>
</div>

<div class="card">
    <h2>Getting started</h2>
    <p class="muted">
        The pages for requests, devices and enrollment keys arrive with the packages that own them.
        Installs, the catalog and administrators can be managed now.
    </p>
</div>
