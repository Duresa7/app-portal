@page "/admin/installs/{id}"
@model AppPortal.Server.Pages.Admin.Installs.DetailModel
@{
    ViewData["Title"] = Model.Install.AppName;
    ViewData["Nav"] = "installs";
    string Or(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string When(DateTimeOffset? at) => at is { } t ? t.ToLocalTime().ToString("u") : "—";
}
<div class="card">
    <h2>Install</h2>
    <dl class="detail">
        <dt>Id</dt>
        <dd><code>@Model.Install.Id</code></dd>

        <dt>App</dt>
        <dd>@Model.Install.AppName <span class="muted">@Model.Install.AppId</span></dd>

        <dt>Device</dt>
        <dd>@Model.Install.DeviceName</dd>

        <dt>Requested by</dt>
        <dd>@Or(Model.Install.RequestedBy)</dd>

        <dt>Engine</dt>
        <dd>@Model.Install.EngineText</dd>

        <dt>State</dt>
        <dd>
            <span class="pill @(Model.Install.State == AppPortal.Shared.InstallState.Failed ? "off" : "")">@Model.Install.State</span>
            @if (Model.Install.IsActive)
            {
                <span class="muted">@Model.Install.PercentComplete%</span>
            }
        </dd>

        <dt>Detail</dt>
        <dd>@Or(Model.Install.Detail)</dd>

        <dt>Requested at</dt>
        <dd>@When(Model.Install.RequestedAt)</dd>

        <dt>Completed at</dt>
        <dd>@When(Model.Install.CompletedAt)</dd>

        <dt>Last checked</dt>
        <dd>@When(Model.Install.LastCheckedAt)</dd>

        <dt>Action1 endpoint</dt>
        <dd><code>@Or(Model.Install.EndpointId)</code></dd>

        <dt>External reference</dt>
        <dd>
            <code>@Or(Model.Install.AutomationId)</code>
            <div class="muted">The automation instance Action1 is running this under.</div>
        </dd>
    </dl>
    <div class="actions">
        <a class="button secondary" href="/admin/installs">Back to installs</a>
        <a class="button secondary" href="/admin/installs?Device=@Uri.EscapeDataString(Model.Install.DeviceName)">Everything on this device</a>
    </div>
</div>
