@page "/admin/requests"
@model AppPortal.Server.Pages.Admin.Requests.IndexModel
@{
    ViewData["Title"] = "Requests";
    ViewData["Nav"] = "requests";
}
@* Swapped out of band after a decision, so the message appears without the page being reloaded. *@
<div id="decide-message">
    @if (Model.Error is not null)
    {
        <div class="message error">@Model.Error</div>
    }
    else if (Model.Notice is not null)
    {
        <div class="message ok">@Model.Notice</div>
    }
</div>

<div class="card">
    <div class="actions" style="margin-top: 0">
        @foreach (var tab in AppPortal.Server.Pages.Admin.Requests.IndexModel.Tabs)
        {
            <a class="@(Model.Tab == tab.Key ? "nav-item current" : "nav-item")" href="/admin/requests?tab=@tab.Key">@tab.Label</a>
        }
    </div>
</div>

<div class="card">
    <partial name="_RequestTable" model="@(new AppPortal.Server.Pages.Admin.Requests.RequestTableView(
                                              Model.Items, Model.Tab, Model.PageNumber, Model.HasNextPage, Model.PendingCount,
                                              null, false, false))" />
</div>
