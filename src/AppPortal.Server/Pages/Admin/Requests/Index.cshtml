@page "/admin/requests"
@model IndexModel
@{
    ViewData["Title"] = "Requests";
    ViewData["Nav"] = "requests";
}
@* Swapped out of band after a decision, so the message appears without the page being reloaded. *@
<div id="decide-message">
    @if (Model.Error is not null)
    {
        <div class="message error">@Model.Error</div>
    }
    else if (Model.Notice is not null)
    {
        <div class="message ok">@Model.Notice</div>
    }
</div>

<div class="card">
    <div class="actions" style="margin-top: 0">
        @foreach (var tab in IndexModel.Tabs)
        {
            <a class="@(Model.Filter == tab.Filter ? "nav-item current" : "nav-item")" href="/admin/requests?tab=@tab.Filter.Tab">@tab.Label</a>
        }
    </div>
</div>

<div class="card">
    <partial name="_RequestTable" model="Model.Slice" />
</div>
