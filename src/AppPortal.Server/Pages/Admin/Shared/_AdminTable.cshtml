@using AppPortal.Server.Admin.Lists
@model Slice<AdminRecord>
<table id="admin-table">
    <thead>
    <tr>
        <th>User name</th>
        <th>Password</th>
        <th>Status</th>
        <th>Last signed in</th>
        <th class="right">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var admin in Model.Rows)
    {
        <tr>
            <td>@admin.Username</td>
            <td class="muted">@(admin.IsDirectory ? "Directory" : "Local")</td>
            <td>
                @if (admin.Disabled)
                {
                    <span class="pill off">Disabled</span>
                }
                else
                {
                    <span class="pill">Enabled</span>
                }
            </td>
            <td class="muted">@(admin.LastLoginAt is { } at ? at.ToLocalTime().ToString("u") : "never")</td>
            <td class="right">
                @if (!admin.Disabled)
                {
                    @* Serialised rather than interpolated: a directory name is DOMAIN\user, and a backslash
                       dropped straight into JSON is an escape sequence. *@
                    <button class="secondary"
                            hx-post="/admin/admins?handler=Disable"
                            hx-vals='@System.Text.Json.JsonSerializer.Serialize(new { username = admin.Username })'
                            hx-target="#admin-table"
                            hx-swap="outerHTML">Disable</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
